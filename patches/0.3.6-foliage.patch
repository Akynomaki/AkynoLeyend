+/* ---- the fonts: regular and bold, loaded once ---- */
+typedef struct { unsigned char *data; stbtt_fontinfo info; int ok; } Face;
+static Face faces[2];
+static pthread_once_t faces_once = PTHREAD_ONCE_INIT;
