+    while (n && path[n - 1] != '/') n--;
+    snprintf(path + n, sizeof path - n, "SDL2.dll");   /* (beside the executable first: LoadLibraryA makes it libSDL2-2.0.so.0) */
+    void *m = LoadLibraryA(path);
