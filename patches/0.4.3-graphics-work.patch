-/* a record's payload: variable-length records (bindings of n items) are shorter than their type (the rest: zeros) */
-template <class T>
-T payload(const uint8_t* a, uint32_t bytes) {
-    T v{};
-    std::memcpy(&v, a, std::min<size_t>(sizeof v, bytes));
-    return v;
-}
