-    case NVN_BLEND_FUNC_SRC_COLOR: return WGPUBlendFactor_Src;
-    case NVN_BLEND_FUNC_ONE_MINUS_SRC_COLOR: return WGPUBlendFactor_OneMinusSrc;
-    case NVN_BLEND_FUNC_SRC_ALPHA: return WGPUBlendFactor_SrcAlpha;
