-    switch (program.stage) {
-    case Stage::VertexA:
-    case Stage::VertexB:
-        stage_name = "vs";
-        group = 0;
-        break;
-    case Stage::Fragment:
-        stage_name = "fs";
-        position_name = "gl_FragCoord";
-        group = 1;
-        break;
-    case Stage::Compute:
-        stage_name = "cs";
-        group = 0;
-        break;
