-    for (size_t i = 0; i < stream_pool.size();) {
-        PooledStream& e = stream_pool[i];
-        if (e.reset || now - e.since < 10000000000LL) {
-            i++;
-            continue;
-        }
-        const uint64_t len = std::min<uint64_t>(e.capacity, keep);
