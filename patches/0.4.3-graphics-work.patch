-bool occlusion_draw_begin() {
-    if (!occ_counting || !pass || !occ_open || pass_occlusion != occ_open->set ||
-        occ_open->used >= OcclusionSet::kQueries)
-        return false;
-    rp_begin_occlusion_query(pass, occ_open->used++);
-    return true;
