-void occlusion_reset() {
-    if (!occlusion_queries()) return;
-    occ_counting = true;
-    OcclusionSet* o = occ_set();
-    if (pass && pass_occlusion != o->set) end_render_pass("pe_occlusion");   // (the next pass counts)
-    occ_first = o->used;
