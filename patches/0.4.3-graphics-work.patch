-                                : t.kind == TexKind::UnfilterableFloat ? WGPUTextureSampleType_UnfilterableFloat
-                                : t.kind == TexKind::Depth             ? WGPUTextureSampleType_Depth
-                                : t.kind == TexKind::Uint              ? WGPUTextureSampleType_Uint
