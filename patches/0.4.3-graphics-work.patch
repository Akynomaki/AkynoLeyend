-    case CompareOp::False:
-        return ir.Imm1(false);
-    case CompareOp::LessThan:
-        return ir.ILessThan(operand_1, operand_2, is_signed);
-    case CompareOp::Equal:
-        return ir.IEqual(operand_1, operand_2);
