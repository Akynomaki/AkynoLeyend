-    const size_t stride = ((size_t)im->width * 4 + 255) & ~size_t(255), size = stride * im->height;
-    if (s.size != size) {
-        if (s.buf) wgpuBufferRelease(s.buf);
-        WGPUBufferDescriptor bd{};
-        bd.size = size;
-        bd.usage = WGPUBufferUsage_CopyDst | WGPUBufferUsage_MapRead;
