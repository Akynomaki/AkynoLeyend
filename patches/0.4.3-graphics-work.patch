-    const IR::Value coords{MakeCoords(v, tex.coord_reg, tex.type)};
-
-    IR::Reg meta_reg{tex.meta_reg};
-    IR::Value handle;
-    IR::Value offset;
-    IR::F32 dref;
-    IR::F32 lod_clamp;
-    if (cbuf_offset) {
-        handle = v.ir.Imm32(*cbuf_offset);
