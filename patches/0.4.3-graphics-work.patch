-        WGPUBufferMapCallbackInfo mc{};
-        mc.mode = WGPUCallbackMode_AllowSpontaneous;
-        mc.callback = [](WGPUMapAsyncStatus status, WGPUStringView, void* u1, void*) {
-            const int i = (int)(intptr_t)u1;
