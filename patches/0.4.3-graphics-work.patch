-void put_layouts(Writer& w, const std::vector<WGPUBindGroupLayoutEntry>* layouts, int n) {
-    w.put((uint32_t)n);
-    for (int i = 0; i < n; i++) {
-        w.put((uint32_t)layouts[i].size());
-        w.bytes(layouts[i].data(), layouts[i].size() * sizeof(WGPUBindGroupLayoutEntry));
-    }
-}
