-std::pair<int, bool> GetSize(u64 insn) {
-    union {
-        u64 raw;
-        BitField<48, 3, Size> size;
-    } const encoding{insn};
-
-    switch (encoding.size) {
-    case Size::U8:
-        return {8, false};
-    case Size::S8:
-        return {8, true};
-    case Size::U16:
-        return {16, false};
-    case Size::S16:
-        return {16, true};
-    case Size::B32:
-        return {32, false};
-    case Size::B64:
-        return {64, false};
-    case Size::B128:
-        return {128, false};
-    default:
-        throw NotImplementedException("Invalid size {}", encoding.size.Value());
-    }
-}
