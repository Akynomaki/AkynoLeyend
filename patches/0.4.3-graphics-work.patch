-        sl.binding = b + 1;
-        sl.visibility = vis;
-        sl.sampler.type = t.kind == TexKind::Depth             ? WGPUSamplerBindingType_Comparison
-                          : t.kind == TexKind::UnfilterableFloat ? WGPUSamplerBindingType_NonFiltering
-                                                                 : WGPUSamplerBindingType_Filtering;
