-    }
-    if (frame_dump_active()) {
-        char line[160];
-        std::snprintf(line, sizeof line, "nvn vertex program %016llx as compute: %u x %u", (unsigned long long)prog.vs.key,
-                      d.count, d.instances);
-        dump_draw(line);
