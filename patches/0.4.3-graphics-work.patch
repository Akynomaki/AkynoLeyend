-void EmitGetCbufU32x2(EmitContext& ctx, IR::Inst& inst, const IR::Value& binding,
-                      const IR::Value& offset) {
-    const auto cast{""};
-    if (offset.IsImmediate()) {
-        static constexpr u32 cbuf_size{0x10000};
-        const u32 u32_offset{offset.U32()};
-        const s32 signed_offset{static_cast<s32>(offset.U32())};
-        if (signed_offset < 0 || u32_offset > cbuf_size) {
-            LOG_WARNING(Shader_WGSL, "Immediate constant buffer offset is out of bounds");
-            ctx.AddU32x2("{}=vec2<u32>(0u);", inst);
-            return;
-        }
-        const auto first{ChooseCbuf(ctx, binding, fmt::format("{}", u32_offset / 16))};
-        if (u32_offset % 16 <= 8 && u32_offset % 4 == 0) {
-            ctx.AddU32x2("{}={}({}.{}{});", inst, cast, first, OffsetSwizzle(u32_offset),
-                         OffsetSwizzle(u32_offset + 4));
-        } else {
-            const auto second{ChooseCbuf(ctx, binding, fmt::format("{}", (u32_offset + 4) / 16))};
-            ctx.AddU32x2("{}=vec2<u32>({}({}.{}),{}({}.{}));", inst, cast, first, OffsetSwizzle(u32_offset), cast,
-                         second, OffsetSwizzle(u32_offset + 4));
-        }
-        return;
-    }
-    const auto offset_var{ctx.var_alloc.Consume(offset)};
-    const auto cbuf{ChooseCbuf(ctx, binding, fmt::format("{}>>4", offset_var), true)};
-    if (!ctx.profile.has_gl_component_indexing_bug) {
-        ctx.AddU32x2("{}=vec2<u32>({}({}[({}>>2)%4]),{}({}[(({}+4)>>2)%4]));", inst, cast, cbuf,
-                     offset_var, cast, cbuf, offset_var);
-        return;
-    }
-    const auto ret{ctx.var_alloc.Define(inst, WgslVarType::U32x2)};
-    const auto cbuf_offset{fmt::format("{}>>2", offset_var)};
-    for (u32 swizzle = 0; swizzle < 4; ++swizzle) {
-        ctx.Add("if(({}&3)=={}){}=vec2<u32>({}({}.{}),{}({}.{}));", cbuf_offset, swizzle, ret, cast,
-                cbuf, "xyzw"[swizzle], cast, cbuf, "xyzw"[(swizzle + 1) % 4]);
-    }
-}
