-/// (mkw-recomp) A bind group checked at creation: null when it is invalid (a view of a texture that was not made, a
-/// buffer the GPU had no memory for). wgpu-native aborts the process at a submit that uses an invalid group, so the
-/// draw or dispatch it was for is left out instead (logged).
-WGPUBindGroup checked_bind_group(const WGPUBindGroupDescriptor& d, const char* what) {
-    scope_push(false);   // (one scope: made for each dispatch, and a scope's pop waits for its answer)
-    WGPUBindGroup g = wgpuDeviceCreateBindGroup(dev.device, &d);
-    if (const std::string error = scope_pop(); !error.empty()) {
-        log_limited("bind_group_invalid", 24, "rx: %s bind group invalid, left out: %s", what, error.c_str());
-        count("bind_groups_invalid");
-        if (g) wgpuBindGroupRelease(g);
-        return nullptr;
-    }
-    return g;
-}
