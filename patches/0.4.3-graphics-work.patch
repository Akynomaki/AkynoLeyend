-    Ceil = 10,
-    Trunc = 11,
-};
-
-[[nodiscard]] u32 WidthSize(FloatFormat width) {
-    switch (width) {
-    case FloatFormat::F16:
-        return 16;
-    case FloatFormat::F32:
