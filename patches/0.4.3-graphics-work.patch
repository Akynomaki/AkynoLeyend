-/* (mkw-recomp) RX_INDIRECT_SYNC=1: indirect draws and dispatches read their arguments back, as before */
-bool indirect_draws_on_gpu() {
-    static const bool sync = env_flag("RX_INDIRECT_SYNC");
-    return !sync && buffer_cache_active();
-}
-
-/* (mkw-recomp) An indirect draw command as one GPU multi-draw: its arguments (and count) copied on the GPU from where
-   they are in the buffer cache into a ring of their own (packed; a buffer bound for writing in the pass could hold
-   them), the draws drawn from there. False: not so (the caller reads the arguments back). Reading them back stopped
-   the GPU 2-3 times a race frame. */
-bool nvn_indirect_on_gpu(NvnState& s, const nvn_p_draw_indirect& d, uint32_t words, uint32_t stride, uint32_t n) {
-    if (!indirect_draws_on_gpu() || (d.count_addr && !dev.multi_draw_count)) return false;
-    const uint64_t span = (uint64_t)(n - 1) * stride + 4 * words, packed = (uint64_t)n * 4 * words;
-    if (span > (8u << 20) || (stride != 4 * words && n > 1024)) return false;
-    if (!rx_gpu_writes_in_cache(d.indirect, span) || (d.count_addr && !rx_gpu_writes_in_cache(d.count_addr, 4))) return false;
-    const BufferRef args = guest_buffer(d.indirect, span);
-    if (!args.buffer || args.offset % 4) return false;
-    BufferRef cnt;
-    if (d.count_addr) {
-        cnt = guest_buffer(d.count_addr, 4);
-        if (!cnt.buffer || cnt.offset % 4) return false;
-    }
-    static WGPUBuffer ring;
-    static uint64_t at;
-    constexpr uint64_t kRing = 8u << 20;
-    if (!ring) {
-        WGPUBufferDescriptor bd{};
-        bd.label = sv("rx indirect draws");
-        bd.size = kRing;
-        bd.usage = WGPUBufferUsage_Indirect | WGPUBufferUsage_CopyDst;
-        ring = wgpuDeviceCreateBuffer(dev.device, &bd);
-    }
-    NvnDraw w;
-    w.prim = d.prim, w.indexed = d.indexed != 0, w.index_type = d.itype, w.index_gpu = d.ibuf;
-    w.count = 1, w.instances = 1, w.indirect_max = n;
-    // packed arguments are read where they are: in a render pass the buffer cache's segments are only read (vertices,
-    // indices, read-only storage; written storage is copied), which indirect use may share. A copy ended the pass
-    // each time (63 times a race frame: the replay's draw time 10 -> 17 ms). RX_INDIRECT_COPY=1: always copied
-    static const bool copy_always = env_flag("RX_INDIRECT_COPY");
-    if (stride == 4 * words && !copy_always) {
-        w.indirect = args.buffer, w.indirect_offset = args.offset;
-        if (d.count_addr) w.count_buffer = cnt.buffer, w.count_offset = cnt.offset;
-        count("indirect_in_place");
-    } else {
-        const uint64_t need = packed + 256;
-        if (at + need > kRing) at = 0;   // (in turn: each copy runs before its draws, in order)
-        const uint64_t off = at, count_off = (off + packed + 15) & ~15ull;
-        at = (count_off + 16 + 255) & ~255ull;
-        end_render_pass("pe_indirect_args");
-        if (stride == 4 * words) {
-            ce_copy_buffer_to_buffer(encoder(), args.buffer, args.offset, ring, off, packed);
-        } else {
-            for (uint32_t i = 0; i < n; i++)
-                ce_copy_buffer_to_buffer(encoder(), args.buffer, args.offset + (uint64_t)i * stride, ring,
-                                         off + (uint64_t)i * 4 * words, 4 * words);
-        }
-        if (d.count_addr) ce_copy_buffer_to_buffer(encoder(), cnt.buffer, cnt.offset, ring, count_off, 4);
-        w.indirect = ring, w.indirect_offset = off;
-        if (d.count_addr) w.count_buffer = ring, w.count_offset = count_off;
-    }
-    nvn_draw_indirect_refused = false;
-    nvn_draw(s, w);
-    if (nvn_draw_indirect_refused) return false;
-    count("nvn_indirect_gpu", n);
-    return true;
-}
