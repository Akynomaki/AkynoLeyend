-std::string_view AttributeTypeName(AttributeType type) {
-    switch (type) {
-    case AttributeType::SignedInt:
-    case AttributeType::SignedScaled:
-        return "vec4<i32>";
-    case AttributeType::UnsignedInt:
-    case AttributeType::UnsignedScaled:
-        return "vec4<u32>";
-    default:
-        return "vec4<f32>";
-    }
-}
