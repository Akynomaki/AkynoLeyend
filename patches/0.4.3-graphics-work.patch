-        max_dim && info.dimension == WGPUTextureDimension_2D && info.size.depth == 1 && !info.linear &&
-        std::max(info.size.width, info.size.height) > max_dim && info.levels > 2) {
-        const Extent2D tile{DefaultBlockWidth(info.format), DefaultBlockHeight(info.format)};
-        const u32 bpp_log2 = BytesPerBlockLog2(BytesPerBlock(info.format));
-        if (info.layers > 1) {
