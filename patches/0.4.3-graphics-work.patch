-    default:
-        break;
-    }
-}
-
-void VisitBlock(Pass& pass, IR::Block* block) {
-    for (IR::Inst& inst : block->Instructions()) {
-        VisitInst(pass, block, inst);
-    }
-    pass.SealBlock(block);
