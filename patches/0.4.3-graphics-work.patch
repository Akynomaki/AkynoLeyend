-std::string_view InterpolationAttribute(Interpolation interp) {
-    switch (interp) {
-    case Interpolation::Flat:
-        return "@interpolate(flat) ";
-    case Interpolation::NoPerspective:
-        return "@interpolate(linear) ";
-    default:
-        return "";
-    }
