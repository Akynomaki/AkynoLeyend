-    case P::BC3_UNORM: case P::BC3_SRGB:
-        return dev.bc ? Convert::None : Convert::Bc3;
-    case P::BC4_UNORM:
-        return dev.bc ? Convert::None : Convert::Bc4;
-    case P::BC4_SNORM:
-        return dev.bc ? Convert::None : Convert::Bc4Snorm;
-    case P::BC5_UNORM:
-        return dev.bc ? Convert::None : Convert::Bc5;
-    case P::BC5_SNORM:
