-IR::U32 ExtractHalf(TranslatorVisitor& v, const IR::U32& src, Half half, bool is_signed) {
-    const IR::U32 offset{v.ir.Imm32(half == Half::H1 ? 16 : 0)};
-    return v.ir.BitFieldExtract(src, offset, v.ir.Imm32(16), is_signed);
-}
