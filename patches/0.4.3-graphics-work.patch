-    const uint32_t clip_width = r.surface_clip.x + r.surface_clip.width;
-    const uint32_t clip_height = r.surface_clip.y + r.surface_clip.height;
-    if (clip_width && clip_width < w && w - clip_width < 64) w = clip_width;
