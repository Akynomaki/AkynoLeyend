-template <typename ReturnType, typename LambdaType, typename... Args>
-struct LambdaTraits<ReturnType (LambdaType::*)(Args...) const> {
-    template <size_t I>
-    using ArgType = std::tuple_element_t<I, std::tuple<Args...>>;
