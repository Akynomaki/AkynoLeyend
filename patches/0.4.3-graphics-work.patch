-    /// replay thread; info is set when the module is made and not changed after)
-    uint32_t generic_loads() const {
-        if (!generic_loads_ok) {
-            uint32_t m = 0;
-            for (uint32_t i = 0; i < 32; i++) m |= (info.loads.Generic(i) ? 1u : 0u) << i;
-            generic_loads_mask = m, generic_loads_ok = true;
