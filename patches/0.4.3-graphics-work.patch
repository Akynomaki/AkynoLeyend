-// ---- occlusion counts: NVN's SAMPLES_PASSED from occlusion queries ----
-// TOTK's occlusion culling draws a 256x144 occluder depth, then a bounding-volume proxy for each candidate object
-// between a SAMPLES_PASSED reset and a report, and does not draw an object whose report is 0 (MacNativeGames'
-// nvn_mtl.m says the same). Each draw between a reset and its report gets an occlusion query in the batch's query
-// set; at the batch's end the set is resolved and read back, and each report's counter word is written with the sum
-// of its queries once the GPU is done (rx_nvn.cpp writes the timestamp word at the replay). Draws left without a
-// query (skipped, or the set full) add the estimate (`extra`); a report whose draws span two batches is the estimate.
-namespace {
-std::vector<std::function<void(bool)>> open_afters;   // (flush_batch's: after its submit)
-struct OcclusionSet {
-    static constexpr uint32_t kQueries = 1024;
-    WGPUQuerySet set = nullptr;
-    WGPUBuffer resolve = nullptr, read = nullptr;
-    uint32_t used = 0;
-    struct Report {
-        uint64_t addr, extra;
-        uint32_t first, n;
-    };
-    std::vector<Report> reports;
-};
-OcclusionSet* occ_open;   // the open batch's (render thread)
-bool occ_counting;        // between a reset and its report
-uint32_t occ_first;       // the reset's first query in occ_open
-uint64_t occ_gen, occ_reset_gen, occ_queried;   // occ_gen: batches flushed
-std::mutex occ_mu;
-std::vector<OcclusionSet*> occ_pool;
-
-OcclusionSet* occ_set() {
-    if (occ_open) return occ_open;
-    {
-        std::lock_guard lk(occ_mu);
-        if (!occ_pool.empty()) {
-            occ_open = occ_pool.back();
-            occ_pool.pop_back();
-            return occ_open;
-        }
-    }
-    auto* o = new OcclusionSet();
-    WGPUQuerySetDescriptor qd{};
-    qd.type = WGPUQueryType_Occlusion;
-    qd.count = OcclusionSet::kQueries;
-    o->set = wgpuDeviceCreateQuerySet(dev.device, &qd);
-    WGPUBufferDescriptor bd{};
-    bd.size = OcclusionSet::kQueries * 8;
-    bd.usage = WGPUBufferUsage_QueryResolve | WGPUBufferUsage_CopySrc;
-    o->resolve = wgpuDeviceCreateBuffer(dev.device, &bd);
-    bd.usage = WGPUBufferUsage_MapRead | WGPUBufferUsage_CopyDst;
-    o->read = wgpuDeviceCreateBuffer(dev.device, &bd);
-    return occ_open = o;
-}
-
-// RX_OCCLUSION_LOG=1: every 5 s, the reports and how many were 0 / estimated; =2 also each report (the first 2000)
-void occ_done(OcclusionSet* o, const uint64_t* counts) {
-    static const int log = [] {
-        const char* e = getenv("RX_OCCLUSION_LOG");
-        return e ? std::atoi(e) : 0;
-    }();
-    static int logged;
-    static uint64_t reports, zeros, estimated, unread;
-    static int64_t since;
-    for (const OcclusionSet::Report& r : o->reports) {
-        uint64_t v = r.extra;
-        for (uint32_t i = 0; i < r.n; i++) v += counts ? counts[r.first + i] : 16;
-        nvn_gpu_write(r.addr, &v, 8);
-        reports++, zeros += v == 0, estimated += r.extra != 0, unread += !counts;
-        if (log >= 2 && logged < 2000) {
-            logged++;
-            hos_log("rx: occlusion report %llx = %llu (%u queries, %llu estimated)%s", (unsigned long long)r.addr,
-                    (unsigned long long)v, r.n, (unsigned long long)r.extra, counts ? "" : " (not read)");
-        }
-    }
-    if (log && hos_now_ns() - since > 5000000000) {
-        if (since)
-            hos_log("rx: occlusion: %llu reports in 5 s, %llu of them 0, %llu with estimated draws, %llu not read",
-                    (unsigned long long)reports, (unsigned long long)zeros, (unsigned long long)estimated,
-                    (unsigned long long)unread);
-        reports = zeros = estimated = unread = 0;
-        since = hos_now_ns();
-    }
-    o->reports.clear();
-    o->used = 0;
-    std::lock_guard lk(occ_mu);
-    occ_pool.push_back(o);
-}
-
-WGPUQuerySet occlusion_pass_set() { return occ_counting ? occ_set()->set : nullptr; }
-
-/// At a batch's end: its query set is resolved into the batch and read back after the submit.
-void occlusion_flush() {
-    OcclusionSet* o = occ_open;
-    if (!o) return;
-    occ_open = nullptr;
-    occ_gen++;
-    if (o->used) {
-        ce_resolve_query_set(encoder(), o->set, 0, o->used, o->resolve, 0);
-        ce_copy_buffer_to_buffer(encoder(), o->resolve, 0, o->read, 0, uint64_t{o->used} * 8);
-    }
-    open_afters.push_back([o](bool submitted) {   // (the submit thread, after the batch's submit)
-        if (!submitted || !o->used) return occ_done(o, nullptr);
-        WGPUBufferMapCallbackInfo mc{};
-        mc.mode = WGPUCallbackMode_AllowSpontaneous;
-        mc.callback = [](WGPUMapAsyncStatus status, WGPUStringView, void* u1, void*) {
-            auto* o = static_cast<OcclusionSet*>(u1);
-            const bool ok = status == WGPUMapAsyncStatus_Success;
-            occ_done(o, ok ? static_cast<const uint64_t*>(wgpuBufferGetConstMappedRange(o->read, 0, uint64_t{o->used} * 8))
-                           : nullptr);
-            if (ok) wgpuBufferUnmap(o->read);
-        };
-        mc.userdata1 = o;
-        wgpuBufferMapAsync(o->read, WGPUMapMode_Read, 0, uint64_t{o->used} * 8, mc);
-    });
-}
-}   // namespace
-}   // namespace (the file's)
