-/// Decodes the texture into a new WebGPU texture.
-std::unique_ptr<Image> decode(const TICEntry& tic, const TexInfo& info_in, uint64_t va) {
-    TexInfo info = info_in;
-    // (mkw-recomp) Large 2D textures and arrays leave out their top levels down to RX_TEXTURE_MAX_DIM (default 2048;
-    // 0: all): MKW's scenes sample 1200+ textures, 4.5 GB decoded, which with the rest ran the GPU out of memory, and
-    // its terrain samples three sparse 8192x8192 x68 arrays (1.4-5.8 GB whole). A texture keeps at least two levels;
-    // the levels kept have their layout, so the data starts at the first one kept, and an array's layers keep their
-    // stride (layer_stride_kept, and the bytes it spans: total_kept).
-    u32 layer_stride_kept = 0;
-    uint64_t total_kept = 0;
