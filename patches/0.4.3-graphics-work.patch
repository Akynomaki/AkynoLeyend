-void EmitGetCbufU32x2(EmitContext& ctx, IR::Inst& inst, const IR::Value& binding,
-                      const IR::Value& offset) {
-    const auto cast{ctx.profile.has_gl_cbuf_ftou_bug ? "" : "ftou"};
