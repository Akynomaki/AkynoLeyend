-void Inst::SetArg(size_t index, Value value) {
-    if (index >= NumArgs()) {
-        throw InvalidArgument("Out of bounds argument index {} in opcode {}", index, op);
-    }
-    const IR::Value arg{Arg(index)};
-    if (!arg.IsImmediate()) {
-        UndoUse(arg);
-    }
-    if (!value.IsImmediate()) {
-        Use(value);
-    }
-    if (op == Opcode::Phi) {
-        phi_args[index].second = value;
-    } else {
-        args[index] = value;
-    }
-}
