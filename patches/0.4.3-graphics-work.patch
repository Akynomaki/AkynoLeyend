-IR::Inst* PrepareSparse(EmitContext& ctx, IR::Inst& inst) {
-    IR::Inst* const sparse_inst{inst.GetAssociatedPseudoOperation(IR::Opcode::GetSparseFromOp)};
-    if (sparse_inst) {
