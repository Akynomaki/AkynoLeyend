-    case 64:
-    case 128:
-        if (!IR::IsAligned(dest, static_cast<size_t>(bit_size / 32))) {
-            throw NotImplementedException("Unaligned destination register {}", dest);
-        }
-        for (int element = 0; element < bit_size / 32; ++element) {
