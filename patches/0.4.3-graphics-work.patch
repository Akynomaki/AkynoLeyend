-bool holds_range(const Segment& s, uint64_t guest, uint64_t size) {
-    const uint64_t first = (guest - s.base) / kPage, last = (guest + size - 1 - s.base) / kPage;
-    for (uint64_t w = first >> 6; w <= last >> 6; w++) {
