-uint64_t add_module_hashed(uint64_t h, const std::string& wgsl) {   // (mu held)
-    if (!h) return add_module(web_shader_source(wgsl));
-    if (known_modules.count(h) || wgsl.empty()) return h;
-    return add_module(web_shader_source(wgsl));
-}
