-namespace Shader::Backend::WGSL {
-namespace {
-/// A literal operand wrapped in rt_(): WGSL would fold the call at shader creation and reject a domain error.
-std::string Rt(std::string_view v) {
-    const bool literal{!v.empty() && (std::isdigit(static_cast<unsigned char>(v[0])) || v[0] == '-' || v[0] == '.')};
-    return literal ? fmt::format("rt_({})", v) : std::string{v};
-}
-
-void Compare(EmitContext& ctx, IR::Inst& inst, std::string_view lhs, std::string_view rhs,
-             std::string_view op, bool ordered) {
-    const auto nan_op{ordered ? "&&!" : "||"};
-    ctx.AddU1("{}={}{}{}"
-              "{}isnan_({}){}isnan_({});",
-              inst, lhs, op, rhs, nan_op, lhs, nan_op, rhs);
-}
-
-bool IsPrecise(const IR::Inst& inst) {
-    return inst.Flags<IR::FpControl>().no_contraction;
-}
-
-/// A float literal operand of magnitude below 1e-6 (an epsilon guarding a division or a logarithm).
-bool IsEpsilon(std::string_view v) {
-    if (v.size() < 2 || v.back() != 'f') return false;
-    const char c{v[0]};
-    if (!std::isdigit(static_cast<unsigned char>(c)) && c != '-' && c != '.') return false;
-    try {
-        const float f{std::stof(std::string{v.substr(0, v.size() - 1)})};
-        return f != 0.0f && std::fabs(f) < 1e-6f;
-    } catch (...) {
-        return false;
-    }
-}
-} // Anonymous namespace
