-/// (mkw-recomp) The whole texture as one GPU image (all its layers, or its 3D volume) for compute programs that write
-/// it as a layered or 3D image: filed at the texture's storage like a render target, so draws that sample the texture
-/// afterwards take it as drawn by the GPU. Null when it cannot be a storage texture.
-Image* nvn_storage_image(const nvn_tex* t, const nvn_view* v, bool volume) {
-    if (!t || !t->gpu) return nullptr;
-    const nvn_texdesc& d = t->d;
-    const unsigned level = v && v->set_levels ? v->base_level : 0;
-    const int format = v && v->set_format ? v->format : d.format;
-    const PixelFormat pf = nvn_pixel_format(format);
-    if (pf == PixelFormat::Invalid) return nullptr;
-    WGPUTextureFormat wf = wgpu_format(pf);
-    // (as the render targets: 8-bit SNORM and 16-bit norm formats as half floats, which storage textures can be)
-    switch (wf) {
-    case WGPUTextureFormat_RGBA8Snorm: case WGPUTextureFormat_RGBA16Unorm: case WGPUTextureFormat_RGBA16Snorm:
-        wf = WGPUTextureFormat_RGBA16Float; break;
-    case WGPUTextureFormat_RG16Unorm: case WGPUTextureFormat_RG16Snorm: wf = WGPUTextureFormat_RG16Float; break;
-    case WGPUTextureFormat_R16Unorm: case WGPUTextureFormat_R16Snorm: wf = WGPUTextureFormat_R16Float; break;
-    default: break;
-    }
-    if (!wgsl_storage_format(wf)) {
-        log_limited("storage_image_format", 8, "rx: storage image format %#x (NVN %#x) is not a storage format",
-                    (unsigned)wf, format);
-        return nullptr;
-    }
-    const uint32_t w = std::max(1u, d.width >> level), h = std::max(1u, d.height >> level);
-    const uint32_t layers = volume ? 1u : std::max(1u, v && v->set_layers && v->nlayers ? (uint32_t)v->nlayers : d.depth);
-    const uint32_t depth = volume ? std::max(1u, d.depth >> level) : 1u;
-    if (w > dev.limits.maxTextureDimension2D || h > dev.limits.maxTextureDimension2D || layers > dev.limits.maxTextureArrayLayers)
-        return nullptr;
-    const uint64_t gpu = t->gpu + nvn_tex_level_offset(&d, level) + (v && v->set_layers && !volume ? v->min_layer * t->L.layer_size : 0);
-    const uint64_t guest = nvn_gpu_guest(gpu);
-    if (!guest) return nullptr;
-    const WGPUTextureDimension dim = volume ? WGPUTextureDimension_3D : WGPUTextureDimension_2D;
-    auto it = images.find(guest);
-    if (it != images.end() && it->second && it->second->width == w && it->second->height == h &&
-        it->second->layers == layers && it->second->dimension == dim && it->second->format == wf &&
-        (!volume || it->second->volume_depth == depth)) {
-        it->second->last_use = frame_number;
-        return it->second.get();
-    }
-    auto im = std::make_unique<Image>();
-    im->gpu_va = gpu, im->guest = guest, im->width = w, im->height = h, im->layers = layers;
