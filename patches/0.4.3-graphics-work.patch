-const char* kPresentWgsl = R"(
-struct P { con0: vec4<f32>, src: vec4<f32>, rcas: vec4<f32>, rect: vec4<f32> };
-@group(0) @binding(0) var tex: texture_2d<f32>;
-@group(0) @binding(1) var<uniform> p: P;
