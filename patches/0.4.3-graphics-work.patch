-            else if (!cached.indexed) bytes = (uint64_t)(cached.first + cached.count - 1) * stride + end;
-            else bytes = std::max<uint64_t>(vs.size, end);
-            bytes = std::min<uint64_t>((bytes + 3) & ~3ull, std::max<uint64_t>((vs.size + 3) & ~3ull, (end + 3) & ~3ull));
