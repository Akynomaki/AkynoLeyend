-    const IR::F32 y(ir.CompositeExtract(new_inst, 1));
-    const IR::F32 z(ir.CompositeExtract(new_inst, 2));
-    const IR::F32 w(ir.CompositeExtract(new_inst, 3));
-    const IR::F16F32F64 max_value(ir.Imm32(get_max_value()));
