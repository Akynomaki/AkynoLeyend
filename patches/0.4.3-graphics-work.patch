-bool occlusion_report(uint64_t addr, uint64_t extra) {
-    if (!occlusion_queries()) return false;
-    const bool ok = occ_counting && occ_open && occ_reset_gen == occ_gen;
-    occ_counting = false;
-    if (!ok) return false;
-    occ_open->reports.push_back({addr, extra, occ_first, occ_open->used - occ_first});
