-    if (replay_sync()) {
-        run_submit(handles, (size_t)n);
-        std::lock_guard lk(job_mu);
-        jobs_pushed++;
-        jobs_replayed++;
-        return;
-    }
-    NvnJob j;
-    j.handles.assign(handles, handles + n);
-    j.scan = request_scan();
