-// ---- shared helpers ----
-thread_local std::vector<int> scope_counts;   // (mkw-recomp) the scopes each scope_push opened, for its scope_pop
-
-void scope_push(bool out_of_memory) {
-    if (RX_WEB) return;   // (the browser reports errors in its console, and an invalid submit does not end the page)
-    scope_counts.push_back(out_of_memory ? 2 : 1);
-    // ((mkw-recomp) out-of-memory errors too: a filter of their own, which a validation scope does not catch. A
-    // buffer the GPU had no memory for was kept as if made, and the submit that used it aborted the process)
-    if (out_of_memory) wgpuDevicePushErrorScope(dev.device, WGPUErrorFilter_OutOfMemory);
-    wgpuDevicePushErrorScope(dev.device, WGPUErrorFilter_Validation);
-}
-
-std::string scope_pop() {
-    if (RX_WEB) return {};
-    struct ScopeResult {
-        std::mutex mutex;
-        std::condition_variable ready;
-        bool complete = false;
-        std::string error;
-    } result;
-    WGPUPopErrorScopeCallbackInfo cb{};
-    cb.mode = WGPUCallbackMode_AllowSpontaneous;
-    cb.callback = [](WGPUPopErrorScopeStatus, WGPUErrorType type, WGPUStringView message, void* u1, void*) {
-        auto& result = *static_cast<ScopeResult*>(u1);
-        {
-            std::lock_guard lock(result.mutex);
-            if (type != WGPUErrorType_NoError) result.error = str(message);
-            result.complete = true;
-        }
-        result.ready.notify_one();
-    };
-    cb.userdata1 = &result;
-    const int scopes = scope_counts.empty() ? 1 : scope_counts.back();
-    if (!scope_counts.empty()) scope_counts.pop_back();
-    for (int scope = 0; scope < scopes; scope++) {   // (validation, then out of memory: scope_push's)
-        {
-            std::lock_guard lock(result.mutex);
-            result.complete = false;
-        }
-        wgpuDevicePopErrorScope(dev.device, cb);
-        std::unique_lock lock(result.mutex);
-        result.ready.wait(lock, [&result] { return result.complete; });
-    }
-    if (result.error.size() > 1500) result.error.resize(1500);
-    return result.error;
-}
