-void Inst::OrderPhiArgs() {
-    if (op != Opcode::Phi) {
-        throw LogicError("{} is not a Phi instruction", op);
-    }
-    std::sort(phi_args.begin(), phi_args.end(),
-              [](const std::pair<Block*, Value>& a, const std::pair<Block*, Value>& b) {
-                  return a.first->GetOrder() < b.first->GetOrder();
-              });
-}
