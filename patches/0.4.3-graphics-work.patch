-// ---- the driver's constant banks (what NVN-compiled programs read for their bindings) ----
-// c0: the storage buffer table (16 bytes a slot: address, size) at 0x110 (vertex), 0x510 (fragment), 0x310 (compute);
-// compute also has its grid at 0x200 and its uniform buffers' table at 0x210; vertex programs clamp the point size to
-// 0x610. c2: texture handles at 0x168 + 8 slot and 0x20 + 8 slot (BindTexture's combined handles, 32 slots), sampler
-// handles at 0x568 + 8 slot, image handles at 0x120 + 8 slot. (Measured on TOTK by the MIT-licensed reference layer.)
-// (mkw-recomp) NVN2 compute programs read a c0 packed for the program: the workgroup counts at 0, then from 0x10 the
-// uniform buffer table (16 bytes a slot: address, size), the storage buffer table (the same), texture handles and
-// image handles (8 bytes a slot), as many slots of each as the program's control section says (+0xb1 uniform
-// buffers, +0xb2 storage buffers, +0xb3 textures, +0xb6 images). Found from 173 programs' reads, all of which fit.
-// Graphics programs keep the fixed layout below (c2 texture handles at 0x20 + 8 slot).
-struct Nvn2CsLayout {
-    uint32_t ubo = 0, ssbo = 0, tex = 0, img = 0;   // slot counts
-    uint32_t ssbo_at() const { return 0x10 + 16 * ubo; }
-    uint32_t tex_at() const { return ssbo_at() + 16 * ssbo; }
-    uint32_t img_at() const { return tex_at() + 8 * tex; }
-    uint32_t end() const { return img_at() + 8 * img; }
-};
-Nvn2CsLayout nvn2_cs_layout(const NvnState& s) {
-    static std::mutex mu;
-    static std::unordered_map<uint64_t, Nvn2CsLayout> by_serial;
-    std::lock_guard lk(mu);
-    if (auto it = by_serial.find(s.prog.serial); it != by_serial.end()) return it->second;
-    Nvn2CsLayout l;
-    for (uint32_t i = 0; i < s.prog.nstage && i < 6; i++) {
-        uint8_t c[0x60];
-        if (!s.prog.sd[i].control || !gpu_read(s.prog.sd[i].control + 0x58, c, sizeof c)) continue;
-        uint32_t magic = 0;
-        uint16_t st = 0;
-        gpu_read(s.prog.sd[i].control, &magic, 4);
-        gpu_read(s.prog.sd[i].control + 0x56, &st, 2);
-        if (magic != 0x98761234 || st != 5) continue;
-        l.ubo = c[0xb1 - 0x58], l.ssbo = c[0xb2 - 0x58], l.tex = c[0xb3 - 0x58], l.img = c[0xb6 - 0x58];
-        break;
-    }
-    if (by_serial.size() > 4096) by_serial.clear();
-    by_serial[s.prog.serial] = l;
-    return l;
-}
-
-void nvn_driver_bank(const NvnState& s, int bank, int stage, uint8_t d[0xA00]) {
-    std::memset(d, 0, 0xA00);
-    if (stage < 0 || stage > 5) return;
-    if (bank == 0 && stage == 5) {   // (NVN2 compute: see Nvn2CsLayout)
-        const Nvn2CsLayout l = nvn2_cs_layout(s);
-        std::memcpy(d, s.grid, sizeof s.grid);
-        auto entry = [&](uint32_t at, const nvn_p_bind_buf& e) {
-            if (at + 16 > 0xA00) return;
-            const uint32_t n = (uint32_t)e.size;
-            std::memcpy(d + at, &e.addr, 8);
-            std::memcpy(d + at + 8, &n, 4);
-        };
-        for (uint32_t r = 0; r < l.ubo && r < 16; r++) entry(0x10 + 16 * r, s.ubo[5][r]);
-        for (uint32_t r = 0; r < l.ssbo && r < 16; r++) entry(l.ssbo_at() + 16 * r, s.ssbo[5][r]);
-        for (uint32_t r = 0; r < l.tex && r < 128 && l.tex_at() + 8 * r + 4 <= 0xA00; r++) {
-            const uint32_t th = (uint32_t)s.tex[5][r];
-            std::memcpy(d + l.tex_at() + 8 * r, &th, 4);
-        }
-        for (uint32_t r = 0; r < l.img && r < 32 && l.img_at() + 8 * r + 4 <= 0xA00; r++) {
-            const uint32_t ih = (uint32_t)s.img[5][r];
-            std::memcpy(d + l.img_at() + 8 * r, &ih, 4);
-        }
-        return;
-    }
-    if (bank == 0) {
-        const int base = stage == 0 ? 0x110 : stage == 5 ? 0x310 : stage == 1 ? 0x510 : -1;
-        if (base >= 0)
-            for (int r = 0; r < 16; r++) {
-                const uint64_t a = s.ssbo[stage][r].addr;
-                const uint32_t n = (uint32_t)s.ssbo[stage][r].size;
-                std::memcpy(d + base + 16 * r, &a, 8);
-                std::memcpy(d + base + 16 * r + 8, &n, 4);
-            }
-        if (stage == 5) {
-            std::memcpy(d + 0x200, s.grid, sizeof s.grid);
-            for (int r = 0; r < 16; r++) {
-                const uint64_t a = s.ubo[5][r].addr;
-                const uint32_t n = (uint32_t)s.ubo[5][r].size;
-                std::memcpy(d + 0x210 + 16 * r, &a, 8);
-                std::memcpy(d + 0x210 + 16 * r + 8, &n, 4);
-            }
-        } else if (stage == 0) {
-            const float point_max = 2047.9375f;
-            std::memcpy(d + 0x610, &point_max, 4);
-        }
-    } else if (bank == 2) {
-        for (int r = 0; r < 128; r++) {
-            const uint32_t th = (uint32_t)s.tex[stage][r], sh = (uint32_t)s.samp[stage][r];
-            std::memcpy(d + 0x168 + 8 * r, &th, 4);
-            std::memcpy(d + 0x568 + 8 * r, &sh, 4);
-        }
-        for (int r = 0; r < 32; r++) {
-            const uint32_t th = (uint32_t)s.tex[stage][r];
-            std::memcpy(d + 0x20 + 8 * r, &th, 4);
-        }
-        for (int r = 0; r < 9; r++) {
-            const uint32_t ih = (uint32_t)s.img[stage][r];
-            std::memcpy(d + 0x120 + 8 * r, &ih, 4);
-        }
-    }
-}
-/// One word of a driver bank, as nvn_driver_bank lays it out (without building the 2.5 KB bank: the programs' handle
-/// and buffer reads, several per draw)
-uint32_t nvn_driver_bank_word(const NvnState& s, int bank, int stage, uint32_t offset) {
-    if (stage < 0 || stage > 5 || offset + 4 > 0xA00 || (offset & 3)) {
-        uint8_t d[0xA00];
-        nvn_driver_bank(s, bank, stage, d);
-        uint32_t w = 0;
-        if (offset + 4 <= sizeof d) std::memcpy(&w, d + offset, 4);
-        return w;
-    }
-    auto lo = [](uint64_t v) { return (uint32_t)v; };
-    auto hi = [](uint64_t v) { return (uint32_t)(v >> 32); };
-    if (bank == 2) {
-        if (offset & 7) return 0;   // (the upper words of the 8-byte slots)
-        if (offset >= 0x568 && offset < 0x568 + 8 * 128) return lo(s.samp[stage][(offset - 0x568) / 8]);
-        if (offset >= 0x168 && offset < 0x168 + 8 * 128) return lo(s.tex[stage][(offset - 0x168) / 8]);
-        if (offset >= 0x120 && offset < 0x120 + 8 * 9) return lo(s.img[stage][(offset - 0x120) / 8]);
-        if (offset >= 0x20 && offset < 0x20 + 8 * 32) return lo(s.tex[stage][(offset - 0x20) / 8]);
-        return 0;
-    }
-    if (bank != 0) return 0;
-    if (stage == 5) {   // (NVN2 compute: see Nvn2CsLayout)
-        const Nvn2CsLayout l = nvn2_cs_layout(s);
-        if (offset < 0x10) return offset < sizeof s.grid ? s.grid[offset / 4] : 0;
-        auto entry = [&](const nvn_p_bind_buf& e, uint32_t in) -> uint32_t {
-            return in == 0 ? lo(e.addr) : in == 4 ? hi(e.addr) : in == 8 ? (uint32_t)e.size : 0;
-        };
-        if (offset < l.ssbo_at()) return (offset - 0x10) / 16 < 16 ? entry(s.ubo[5][(offset - 0x10) / 16], (offset - 0x10) % 16) : 0;
-        if (offset < l.tex_at())
-            return (offset - l.ssbo_at()) / 16 < 16 ? entry(s.ssbo[5][(offset - l.ssbo_at()) / 16], (offset - l.ssbo_at()) % 16) : 0;
-        if (offset < l.img_at()) return (offset & 7) ? 0 : lo(s.tex[5][std::min<uint32_t>((offset - l.tex_at()) / 8, 127)]);
-        if (offset < l.end()) return (offset & 7) ? 0 : lo(s.img[5][std::min<uint32_t>((offset - l.img_at()) / 8, 31)]);
-        return 0;
-    }
-    const uint32_t base = stage == 0 ? 0x110 : stage == 5 ? 0x310 : stage == 1 ? 0x510 : 0;
-    auto table = [&](const nvn_p_bind_buf* t, uint32_t at) -> uint32_t {   // 16-byte entries: address, size, 0
-        const nvn_p_bind_buf& e = t[(offset - at) / 16];
-        switch ((offset - at) % 16) {
-        case 0: return lo(e.addr);
-        case 4: return hi(e.addr);
-        case 8: return (uint32_t)e.size;
-        default: return 0;
-        }
-    };
-    if (stage == 5) {
-        if (offset >= 0x200 && offset < 0x200 + sizeof s.grid) return s.grid[(offset - 0x200) / 4];
-        if (offset >= 0x210 && offset < 0x210 + 16 * 16) return table(s.ubo[5], 0x210);
-    }
-    if (base && offset >= base && offset < base + 16 * 16) return table(s.ssbo[stage], base);
-    if (stage == 0 && offset == 0x610) return std::bit_cast<uint32_t>(2047.9375f);
-    return 0;
-}
