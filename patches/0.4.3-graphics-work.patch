-            m.module = cached;
-            count("cs_module_cached");
-        } else if (create_module(m, "compute", code->key)) {
-            native_cache_compute_text(th, m.wgsl);
-        } else {
-            m.failed = true;
-        }
-        if (!m.failed) count("nvn_compute_programs");
-    }
-    ShaderModule* out = m.failed ? nullptr : &m;
-    list.push_back(std::move(var));
-    return out;
-}
