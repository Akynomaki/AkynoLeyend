-/// A stage's package, read from guest memory and lowered to Maxwell
-struct NvnCode {
-    int stage = -1;          // NVN stage
-    uint64_t data = 0, key = 0;
-    std::vector<uint64_t> code;   // the lowered program as the Maxwell frontend reads it: a graphics stage's header
-                                  // (0x50 bytes; zeros for compute), the instructions from 0x50 with their scheduling
-                                  // words at each 32 bytes, then the native address map (indirect branch targets)
-    std::vector<uint8_t> c1;
-    uint32_t local[3]{};
-    uint32_t shared = 0, local_memory = 0;   // compute: workgroup shared memory, local memory bytes
-    bool ok = false;
-};
-
-constexpr uint32_t kNvn2ControlMagic = 0x98761234;
-constexpr uint32_t kNvn2ControlSize = 0xd8;
-constexpr uint32_t kAmpereHeader = 128;   // (Turing and later: the graphics program header is 128 bytes)
-
-NvnCode read_nvn_code(const nvn_stage_data& sd) {
-    NvnCode c;
-    uint8_t ctl[kNvn2ControlSize];
-    if (!sd.control || !sd.data || !gpu_read(sd.control, ctl, sizeof ctl)) return c;
-    uint32_t magic, len, c1o, end;
-    uint16_t st;
-    std::memcpy(&magic, ctl, 4);
-    std::memcpy(&len, ctl + 0x38, 4);
-    std::memcpy(&c1o, ctl + 0x40, 4);
-    std::memcpy(&end, ctl + 0x44, 4);
-    std::memcpy(&st, ctl + 0x56, 2);
-    if (magic != kNvn2ControlMagic || !len || end > (16u << 20) || c1o > end || len > end || st > 5) {
-        log_limited("nvn_code", 8, "rx: NVN2 shader package at %#llx: magic %#x, code %#x, c1 at %#x..%#x, stage %u",
-                    (unsigned long long)sd.data, magic, len, c1o, end, st);
-        return c;
-    }
-    std::vector<uint8_t> area(end);
-    if (!gpu_read(sd.data, area.data(), end)) return c;
-    c.key = hash_bytes(area.data(), end, hash_bytes(ctl, sizeof ctl));
-    c.stage = (int)st;
-    c.data = sd.data;
-    const bool graphics = st != 5;
-    const uint32_t hdr = graphics ? kAmpereHeader : 0;
-    // the native instructions, to the program's end (the capture stops at its final branch to itself or exit)
-    using Shader::Ampere::Instruction;
-    std::vector<Instruction> native;
-    Shader::Ampere::ProgramCaptureState capture;
-    for (uint32_t i = 0; hdr + (i + 1) * sizeof(Instruction) <= len; i++) {
-        Instruction& insn = native.emplace_back();
-        std::memcpy(&insn, area.data() + hdr + i * sizeof(Instruction), sizeof insn);
-        const auto r = capture.Observe(insn, i);
-        if (r == Shader::Ampere::ProgramCaptureState::Result::InvalidTarget) {
-            log_limited("nvn_capture", 8, "rx: NVN2 program %016llx: branch outside the program at +%#x",
-                        (unsigned long long)c.key, i * 16);
-            return c;
-        }
-        if (r == Shader::Ampere::ProgramCaptureState::Result::Complete) break;
-    }
-    const auto lowered = Shader::Ampere::LowerToMaxwell(native);
-    if (!lowered) {
-        const uint32_t at = lowered.error_offset / 16;
-        const uint64_t lo = at < native.size() ? (uint64_t)native[at].words[0] | (uint64_t)native[at].words[1] << 32 : 0,
-                       hi = at < native.size() ? (uint64_t)native[at].words[2] | (uint64_t)native[at].words[3] << 32 : 0;
-        log_limited("nvn_lower", 30, "rx: NVN2 program %016llx (stage %u, at %#llx) does not lower to Maxwell at +%#x: "
-                    "%s (instruction %016llx %016llx, opcode %#x)", (unsigned long long)c.key, st,
-                    (unsigned long long)sd.data, lowered.error_offset, std::string(lowered.error).c_str(),
-                    (unsigned long long)hi, (unsigned long long)lo, (unsigned)(lo & 0xfff));
-        return c;
-    }
-    c.code.assign(sizeof(Shader::ProgramHeader) / 8, 0);
-    if (graphics) std::memcpy(c.code.data(), area.data(), sizeof(Shader::ProgramHeader));
-    for (const uint64_t instruction : lowered.instructions) {
-        if (c.code.size() * 8 % 32 == 0) c.code.push_back(0);   // (the Maxwell scheduling word)
-        c.code.push_back(instruction);
-    }
-    c.code.push_back(0);
-    Shader::Ampere::AppendNativeAddressMap(c.code, lowered.source_instruction_offsets);
-    c.c1.assign(area.begin() + c1o, area.end());
-    if (!graphics) {
-        std::memcpy(c.local, ctl + 0x58, 12);
-        // (the shared memory size is not found in the control section yet: what the device allows a workgroup)
-        c.shared = 16u << 10;
-    }
-    // RX_NVN_CODE_LOG=1 (debugging): the first packages
-    if (static const bool log_code = env_flag("RX_NVN_CODE_LOG"); log_code) {
-        static int n;
-        if (n++ < 24)
-            hos_log("rx: NVN2 package %016llx stage %u code %#x c1 %#x..%#x at %#llx: %zu native -> %zu Maxwell words",
-                    (unsigned long long)c.key, st, len, c1o, end, (unsigned long long)sd.data, native.size(),
-                    lowered.instructions.size());
-    }
-    c.ok = true;
-    return c;
-}
