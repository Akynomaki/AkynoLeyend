-bool occlusion_queries() {
-    static const bool on = [] {
-        const char* e = getenv("RX_OCCLUSION_QUERIES");
-        return e ? std::atoi(e) != 0 : !RX_WEB;   // (the web: not tried yet)
-    }();
-    return on;
