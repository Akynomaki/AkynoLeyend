+            path.write_text(source)
+            child = subprocess.run(
+                [
+                    compiler,
+                    "-std=c++20",
+                    "-O1",
+                    "-Wall",
+                    "-Wextra",
+                    "-Werror",
+                    "-pthread",
+                    "-I" + str(ROOT / "gpu/vk"),
