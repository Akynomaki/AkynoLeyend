          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Margin="0,16,0,0">
          <StackPanel>
            <TextBlock x:Name="UpdateVersion" Text="Novidades e correções" Style="{StaticResource Section}" />
            <TextBlock x:Name="UpdateChanges" Text="Selecione um pacote para ver o que muda nesta atualização." Style="{StaticResource Note}" Margin="0,12,0,18" TextWrapping="Wrap" />
            <Button x:Name="ApplyUpdateButton" Content="Instalar atualização e reiniciar launcher" Click="ApplySelectedUpdate" Style="{StaticResource Primary}" HorizontalAlignment="Left" IsEnabled="False" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Margin="0,16,0,0">
          <StackPanel>
            <TextBlock Text="Atualizar a build do jogo" Style="{StaticResource Section}" />
            <TextBlock Text="Aplica os componentes já instalados, reaproveitando a compilação existente. Mantenha a pasta work. Se faltar algum objeto necessário, a operação será interrompida com uma explicação." Style="{StaticResource Note}" Margin="0,8,0,18" />
            <Button x:Name="MaintainUpdateButton" Content="Atualizar componentes alterados" Tag="maintain-build" Click="RunTool" Style="{StaticResource Quiet}" HorizontalAlignment="Left" />
          </StackPanel>
        </Border>
        <TextBlock x:Name="UpdatesNote" Style="{StaticResource Note}" Margin="0,18,0,0" TextWrapping="Wrap" />
      </StackPanel>
    </ScrollViewer>
    <ScrollViewer x:Name="ToolsPage" Grid.Row="2" Grid.Column="1" Margin="28,8,26,18" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
      <StackPanel Margin="0,0,10,6">
