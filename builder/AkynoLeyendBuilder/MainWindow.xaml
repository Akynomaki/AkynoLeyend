              <Button Content="Exportar Save" Click="ExportSaves" Style="{StaticResource Quiet}" Margin="0,0,12,10" ToolTip="Copia o save compatível de um emulador (Fritz, MDias, PokeDinner ou Lichii) para a pasta de saves deste port" Width="280" Height="56" />
            </WrapPanel>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Margin="0,20,0,0">
          <StackPanel>
            <TextBlock Text="Diagnóstico" Style="{StaticResource Section}" />
            <TextBlock Text="Reúna os registros da última execução para investigar crashes, iluminação e travamentos." Style="{StaticResource Note}" Margin="0,0,0,20" />
            <WrapPanel>
              <Button Content="Coletar relatório" Tag="collect-crash" Click="RunTool" Style="{StaticResource Quiet}" Margin="0,0,12,10" Width="280" Height="56" />
              <Button Content="Verificar ferramentas" Tag="doctor" Click="RunTool" Style="{StaticResource Quiet}" Margin="0,0,12,10" Width="280" Height="56" />
              <Button Content="Abrir pasta do jogo" Click="OpenGameFolder" Style="{StaticResource Quiet}" Margin="0,0,0,10" Width="280" Height="56" />
            </WrapPanel>
          </StackPanel>
        </Border>
        <TextBlock x:Name="ToolNote" Style="{StaticResource Note}" Margin="0,18,0,0" />
      </StackPanel>
    </ScrollViewer>
