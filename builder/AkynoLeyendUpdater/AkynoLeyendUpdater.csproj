<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Bridge from 0.4.3-test.4 (Teste 4, either branch: r13c to r13j, or the Intel branch r13d/r13e) 0.4.4 0.4.5, 0.4.5-test.1, 0.4.5-test.2, 0.4.5-test.3, 0.4.5-test.4, 0.4.5-test.5, 0.4.5-test.6, 0.4.5-test.7, 0.4.5-test.8, 0.4.6 or 0.4.7 to 0.4.8. Built for Test 3 to
    0.4.3-test.4 first (that "Atualizar build" button could not start the updater).
    Build (the update package is embedded and its SHA-256 is checked at run time):
      dotnet publish -c Release -p:PackagePath=<AkynoLeyend-Atualizacao-0.4.8.zip> -p:PackageSha256=<sha256>
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>AkynoLeyend-Atualizador-0.4.8</AssemblyName>
    <RootNamespace>AkynoLeyendUpdater</RootNamespace>
    <Version>0.4.8</Version>
    <Product>AkynoLeyend</Product>
    <ApplicationIcon>../../assets/AkynoLeyend.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <Target Name="RequirePackage" BeforeTargets="BeforeBuild">
    <Error Condition="'$(PackagePath)' == '' Or !Exists('$(PackagePath)')" Text="Informe -p:PackagePath=&lt;ZIP de atualizacao&gt;." />
    <Error Condition="'$(PackageSha256)' == ''" Text="Informe -p:PackageSha256=&lt;SHA-256 do ZIP&gt;." />
  </Target>

  <ItemGroup>
    <EmbeddedResource Include="$(PackagePath)" LogicalName="AkynoLeyend-Atualizacao.zip" Condition="'$(PackagePath)' != ''" />
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>PackageSha256</_Parameter1>
      <_Parameter2>$(PackageSha256)</_Parameter2>
    </AssemblyAttribute>
    <Compile Include="../AkynoLeyendBuilder/UpdatePreview.cs" Link="UpdatePreview.cs" />
  </ItemGroup>

</Project>
